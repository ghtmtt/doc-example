msgstr ""

#: ../../violin.rst:13
msgid "Plot Properties"
msgstr ""

#: ../../violin.rst:14
msgid "``Layer``: the combobox will display all the vector layers loaded in QGIS"
msgstr ""

#: ../../violin.rst:16
msgid ""
"``Grouping Field (Optional)``: the grouping field. If no field is added, "
"a generic violin plot for the Y value will be displayed"
msgstr ""

#: ../../violin.rst:19
msgid "``Y Field``: the Y field"
msgstr ""

#: ../../violin.rst:21
msgid "``Marker Color``: color of the violin"
msgstr ""

#: ../../violin.rst:23
msgid "``Stroke Color``: border color"
msgstr ""

#: ../../violin.rst:25
msgid "``Stroke Width``: the width of the border"
msgstr ""

#: ../../violin.rst:27
msgid "``Transparency``: transparency level of the violin"
msgstr ""

#: ../../violin.rst:30
msgid "Plot Customizations"
msgstr ""

#: ../../violin.rst:31
msgid "``Show Legend``: show the legend of the current plot"
msgstr ""

#: ../../violin.rst:33
msgid "``Horizontal Legend``: check if you want to have an horizontal legend"
msgstr ""

#: ../../violin.rst:35
msgid "``Plot Title``: the plot title"
msgstr ""

#: ../../violin.rst:37
msgid "``Legend Title``: the title of the legend"
msgstr ""

#: ../../violin.rst:39
msgid "``X Label``: X label text"
msgstr ""

#: ../../violin.rst:41
msgid "``Y Label``: Y Label text"
msgstr ""

#: ../../violin.rst:43
msgid ""
"``Box Orientation``: the orientation of the violin, either *Horizontal* "
"or *Vertical*"
msgstr ""

#: ../../violin.rst:45
msgid ""
"``Outliers``: show also the outliers (or all the points) next to the box."
" Some example in the following picture:"
msgstr ""

#: ../../violin.rst:51
msgid ""
"``Violin side``: if the violin plot should be both sides, only right or "
"only left"
msgstr ""

#: ../../violin.rst:53
msgid "``Show Mean Line``: uncheck to not show a line corresponding to the mean"
msgstr ""

