#: ../../box.rst:4
msgid "Box Plot"
msgstr ""

#: ../../box.rst:5
msgid ""
"Here you will find the guide to every parameter of the box plot. If you "
"need more generic information please the :ref:`basic_usage`."
msgstr ""

#: ../../box.rst:13
msgid "Plot Properties"
msgstr ""

#: ../../box.rst:14
msgid "``Layer``: the combobox will display all the vector layers loaded in QGIS"
msgstr ""

#: ../../box.rst:16
msgid ""
"``Grouping Field (Optional)``: the grouping field. If no field is added, "
"a generic box plot for the Y value will be displayed"
msgstr ""

#: ../../box.rst:19
msgid "``Y Field``: the Y field"
msgstr ""

#: ../../box.rst:21
msgid "``Marker Color``: color of the box"
msgstr ""

#: ../../box.rst:23
msgid "``Stroke Color``: border color"
msgstr ""

#: ../../box.rst:25
msgid "``Stroke Width``: the width of the border"
msgstr ""

#: ../../box.rst:27
msgid "``Transparency``: transparency level of the box"
msgstr ""

#: ../../box.rst:30
msgid "Plot Customizations"
msgstr ""

#: ../../box.rst:31
msgid "``Show Legend``: show the legend of the current plot"
msgstr ""

#: ../../box.rst:33
msgid "``Horizontal Legend``: check if you want to have an horizontal legend"
msgstr ""

#: ../../box.rst:35
msgid "``Plot Title``: the plot title"
msgstr ""

#: ../../box.rst:37
msgid "``Legend Title``: the title of the legend"
msgstr ""

#: ../../box.rst:39
msgid "``X Label``: X label text"
msgstr ""

#: ../../box.rst:41
msgid "``Y Label``: Y Label text"
msgstr ""

#: ../../box.rst:43
msgid "``Invert X Axis``: check if you want to invert the ordering of the x axis"
msgstr ""

#: ../../box.rst:45
msgid "``X Axis Mode``: choose between Linear, Logarithmic or Categorized"
msgstr ""

#: ../../box.rst:47
msgid "``Invert Y Axis``: check if you want to invert the ordering of the y axis"
msgstr ""

#: ../../box.rst:49
msgid "``Y Axis Mode``: choose between Linear, Logarithmic or Categorized"
msgstr ""

#: ../../box.rst:51
msgid ""
"``Box Orientation``: the orientation of the box, either *Horizontal* or "
"*Vertical*"
msgstr ""

#: ../../box.rst:53
msgid ""
"``Show Statistics``: choose to show also additional statistics on each "
"box plot, like the mean or the standard deviation (shown in the picture "
"below)"
msgstr ""

#: ../../box.rst:59
msgid ""
"``Outliers``: show also the outliers (or all the points) next to the box."
" Some example in the following picture:"
msgstr ""

